generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String         @id @default(uuid())
  email             String         @unique
  passwordHash      String?        @map("password_hash")
  firstName         String?        @map("first_name")
  lastName          String?        @map("last_name")
  avatarUrl         String?        @map("avatar_url")
  bio               String?
  country           String?
  languages         Json?
  rating            Int            @default(0)
  isAdmin           Boolean        @default(false) @map("is_admin")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  identityStatus    IdentityStatus @default(NOT_VERIFIED)
  birthDate         DateTime?      @map("birth_date")
  nationality       String?
  phone             String?
  preferredLocale   String         @default("fr")
  travelPreferences Json?

  homes     Home[]
  favorites Favorite[]

  supportRequests SupportRequest[]

  swipesMade     Swipe[]         @relation("SwipesMade")
  swipesReceived Swipe[]         @relation("SwipesReceived")
  searchHistory  SearchHistory[]

  matchesAsUser1 Match[] @relation("MatchesAsUser1")
  matchesAsUser2 Match[] @relation("MatchesAsUser2")

  chatParticipants ChatParticipant[]
  messages         Message[]

  @@map("users")
}

model Home {
  id      String @id @default(uuid())
  ownerId String

  title       String
  description String?
  address     String?
  city        String
  country     String
  latitude    Float?
  longitude   Float?
  capacity    Int
  beds        Int     @default(1)
  bedrooms    Int     @default(1)
  bathrooms   Int     @default(1)
  homeType    String  @map("home_type")
  amenities   Json?

  isAvailableForExchange Boolean @default(true) @map("is_available_for_exchange")
  pricePerNight          Int?    @map("price_per_night")
  averageRating          Float?  @default(0) @map("average_rating")
  reviewsCount           Int     @default(0) @map("reviews_count")

  carExchangeAccepted Boolean  @default(false) @map("car_exchange_accepted")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  owner          User               @relation(fields: [ownerId], references: [id])
  photos         HomePhoto[]
  favorites      Favorite[]
  availabilities HomeAvailability[]
  exchanges      Exchange[]

  vehicle Vehicle?
  swipes  Swipe[]

  @@index([city, country])
  @@index([latitude, longitude])
}

model HomePhoto {
  id     String @id @default(uuid())
  homeId String @map("home_id")
  home   Home   @relation(fields: [homeId], references: [id], onDelete: Cascade)

  url      String
  position Int

  createdAt DateTime @default(now()) @map("created_at")

  @@map("home_photos")
}

enum VehicleFuelType {
  GASOLINE
  HYBRID
  DIESEL
  ELECTRIC
}

model Vehicle {
  id     String @id @default(uuid())
  homeId String @unique
  home   Home   @relation(fields: [homeId], references: [id], onDelete: Cascade)

  brand    String?
  model    String?
  seats    Int?
  type     String? // ex: "city", "suv", etc.
  fuelType VehicleFuelType? @map("fuel_type")

  imageUrl String? @map("image_url")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("vehicles")
}

model Favorite {
  id String @id @default(uuid())

  userId String @map("user_id")
  homeId String @map("home_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  home Home @relation(fields: [homeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, homeId])
  @@map("favorites")
}

enum AvailabilityType {
  AVAILABLE
  BLOCKED
}

model HomeAvailability {
  id     String @id @default(uuid())
  homeId String @map("home_id")
  home   Home   @relation(fields: [homeId], references: [id], onDelete: Cascade)

  startDate DateTime         @map("start_date")
  endDate   DateTime         @map("end_date")
  type      AvailabilityType @default(AVAILABLE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("home_availabilities")
}

enum ExchangeStatus {
  CURRENT
  FUTURE
  PAST
  CANCELLED
}

model Exchange {
  id     String @id @default(uuid())
  homeId String @map("home_id")
  home   Home   @relation(fields: [homeId], references: [id], onDelete: Cascade)

  hostId  String @map("host_id")
  guestId String @map("guest_id")

  startDate      DateTime @map("start_date")
  endDate        DateTime @map("end_date")
  travelersCount Int      @default(1) @map("travelers_count")

  status ExchangeStatus

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("exchanges")
}

enum SwipeDirection {
  LIKE
  DISLIKE
}

enum MatchStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
}

model Swipe {
  id           String         @id @default(uuid())
  swiperId     String
  targetUserId String
  homeId       String
  direction    SwipeDirection
  createdAt    DateTime       @default(now())

  swiper     User @relation("SwipesMade", fields: [swiperId], references: [id])
  targetUser User @relation("SwipesReceived", fields: [targetUserId], references: [id])

  home Home @relation(fields: [homeId], references: [id], onDelete: Cascade)

  @@unique([swiperId, targetUserId])
}

model SearchHistory {
  id        String    @id @default(cuid())
  userId    String
  city      String?
  country   String?
  latitude  Float?
  longitude Float?
  capacity  Int?
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Match {
  id        String      @id @default(uuid())
  user1Id   String
  user2Id   String
  status    MatchStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  chat Chat?

  user1 User @relation("MatchesAsUser1", fields: [user1Id], references: [id])
  user2 User @relation("MatchesAsUser2", fields: [user2Id], references: [id])

  @@unique([user1Id, user2Id])
}

model SupportRequest {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  userEmail    String   @map("user_email")
  userFullName String?  @map("user_full_name")
  topic        String
  subject      String
  message      String
  status       String   @default("open")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("support_requests")
}

enum IdentityStatus {
  NOT_VERIFIED
  IN_PROGRESS
  VERIFIED
  REFUSED
}

model Chat {
  id String @id @default(uuid())

  matchId String @unique
  match   Match  @relation(fields: [matchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ChatParticipant[]
  messages     Message[]
}

model ChatParticipant {
  id String @id @default(uuid())

  chatId String
  userId String

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  joinedAt DateTime @default(now())

  @@unique([chatId, userId])
}

model Message {
  id String @id @default(uuid())

  chatId   String
  senderId String
  content  String

  chat   Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chatId, createdAt])
}
