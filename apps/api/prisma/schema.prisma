generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  passwordHash String? @map("password_hash")
  firstName    String? @map("first_name")
  lastName     String? @map("last_name")
  avatarUrl    String? @map("avatar_url")
  bio          String?
  country      String?
  languages    Json?
  rating       Int     @default(0)
  isAdmin      Boolean @default(false) @map("is_admin")

  suspendedAt       DateTime?      @map("suspended_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  identityStatus    IdentityStatus @default(NOT_VERIFIED)
  birthDate         DateTime?      @map("birth_date")
  nationality       String?
  phone             String?
  preferredLocale   String         @default("fr")
  travelPreferences Json?

  lastSeenAt DateTime? @map("last_seen_at")

  statusText      String?   @map("status_text")
  statusUpdatedAt DateTime? @map("status_updated_at")

  notifyPush          Boolean @default(true) @map("notify_push")
  notifyNewMessages   Boolean @default(true) @map("notify_new_messages")
  notifyExchanges     Boolean @default(true) @map("notify_exchanges")
  notifySms           Boolean @default(false) @map("notify_sms")
  marketingEmails     Boolean @default(false) @map("marketing_emails")
  showPreciseLocation Boolean @default(true) @map("show_precise_location")
  allowMessages       Boolean @default(true) @map("allow_messages")
  distanceUnit        String  @default("km") @map("distance_unit")

  pushTokens PushToken[]

  profileVisible Boolean @default(true) @map("profile_visible")
  showAge        Boolean @default(true) @map("show_age")
  dataSharing    Boolean @default(false) @map("data_sharing")

  homes     Home[]
  favorites Favorite[]

  supportRequests SupportRequest[]

  swipesMade     Swipe[]         @relation("SwipesMade")
  swipesReceived Swipe[]         @relation("SwipesReceived")
  searchHistory  SearchHistory[]

  matchesAsUser1 Match[] @relation("MatchesAsUser1")
  matchesAsUser2 Match[] @relation("MatchesAsUser2")

  chatParticipants ChatParticipant[]
  messages         Message[]
  reviews          Review[]
  blocksMade       BlockedUser[]     @relation("BlocksMade")
  blocksReceived   BlockedUser[]     @relation("BlocksReceived")
  reportsMade      UserReport[]      @relation("ReportsMade")
  reportsReceived  UserReport[]      @relation("ReportsReceived")
  notifications    Notification[]

  @@map("users")
}

model Home {
  id      String @id @default(uuid())
  ownerId String

  title       String
  description String?
  address     String?
  city        String
  country     String
  latitude    Float?
  longitude   Float?
  capacity    Int
  beds        Int           @default(1)
  bedrooms    Int           @default(1)
  bathrooms   Int           @default(1)
  homeType    String        @map("home_type")
  category    HomeCategory?
  amenities   Json?

  isAvailableForExchange Boolean @default(true) @map("is_available_for_exchange")
  pricePerNight          Int?    @map("price_per_night")
  averageRating          Float?  @default(0) @map("average_rating")
  reviewsCount           Int     @default(0) @map("reviews_count")

  carExchangeAccepted Boolean  @default(false) @map("car_exchange_accepted")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  owner          User               @relation(fields: [ownerId], references: [id])
  photos         HomePhoto[]
  favorites      Favorite[]
  availabilities HomeAvailability[]
  exchanges      Exchange[]         @relation("ExchangeHostHome")
  guestExchanges Exchange[]         @relation("ExchangeGuestHome")

  vehicle Vehicle?
  swipes  Swipe[]
  reviews Review[]

  @@index([city, country])
  @@index([latitude, longitude])
}

model HomePhoto {
  id     String @id @default(uuid())
  homeId String @map("home_id")
  home   Home   @relation(fields: [homeId], references: [id], onDelete: Cascade)

  url      String
  position Int

  createdAt DateTime @default(now()) @map("created_at")

  @@map("home_photos")
}

// Theme d'un sejour, choisi par l'hote. Distinct de homeType, qui decrit le
// bati : un chalet peut etre montagne comme culture selon ce qu'on vient y faire.
enum HomeCategory {
  NATURE
  BEACH
  CITY
  CULTURE
}

enum VehicleFuelType {
  GASOLINE
  HYBRID
  DIESEL
  ELECTRIC
}

model Vehicle {
  id     String @id @default(uuid())
  homeId String @unique
  home   Home   @relation(fields: [homeId], references: [id], onDelete: Cascade)

  brand    String?
  model    String?
  seats    Int?
  type     String? // ex: "city", "suv", etc.
  fuelType VehicleFuelType? @map("fuel_type")

  imageUrl String? @map("image_url")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("vehicles")
}

model Favorite {
  id String @id @default(uuid())

  userId String @map("user_id")
  homeId String @map("home_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  home Home @relation(fields: [homeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, homeId])
  @@map("favorites")
}

enum AvailabilityType {
  AVAILABLE
  BLOCKED
}

model HomeAvailability {
  id     String @id @default(uuid())
  homeId String @map("home_id")
  home   Home   @relation(fields: [homeId], references: [id], onDelete: Cascade)

  startDate DateTime         @map("start_date")
  endDate   DateTime         @map("end_date")
  type      AvailabilityType @default(AVAILABLE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("home_availabilities")
}

enum ExchangeStatus {
  PENDING
  DECLINED
  CURRENT
  FUTURE
  PAST
  CANCELLED
}

model Exchange {
  id String @id @default(uuid())

  // Un echange de maison porte deux logements : celui de l'hote, ou l'invite se
  // rend, et celui de l'invite, ou l'hote sejourne en retour. Le second reste
  // facultatif : on peut demander un echange sans encore proposer de logement.
  homeId String @map("home_id")
  home   Home   @relation("ExchangeHostHome", fields: [homeId], references: [id], onDelete: Cascade)

  guestHomeId String? @map("guest_home_id")
  guestHome   Home?   @relation("ExchangeGuestHome", fields: [guestHomeId], references: [id], onDelete: SetNull)

  hostId  String @map("host_id")
  guestId String @map("guest_id")

  startDate      DateTime @map("start_date")
  endDate        DateTime @map("end_date")
  travelersCount Int      @default(1) @map("travelers_count")

  status ExchangeStatus

  reviewReminderAt DateTime? @map("review_reminder_at")
  startReminderAt  DateTime? @map("start_reminder_at")
  endReminderAt    DateTime? @map("end_reminder_at")

  reviews Review[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, endDate])
  @@map("exchanges")
}

enum SwipeDirection {
  LIKE
  DISLIKE
}

enum MatchStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
}

model Swipe {
  id           String         @id @default(uuid())
  swiperId     String
  targetUserId String
  homeId       String
  direction    SwipeDirection
  createdAt    DateTime       @default(now())

  swiper     User @relation("SwipesMade", fields: [swiperId], references: [id])
  targetUser User @relation("SwipesReceived", fields: [targetUserId], references: [id])

  home Home @relation(fields: [homeId], references: [id], onDelete: Cascade)

  @@unique([swiperId, homeId])
}

model SearchHistory {
  id        String    @id @default(cuid())
  userId    String
  city      String?
  country   String?
  latitude  Float?
  longitude Float?
  capacity  Int?
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Match {
  id        String      @id @default(uuid())
  user1Id   String
  user2Id   String
  status    MatchStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  chat Chat?

  user1 User @relation("MatchesAsUser1", fields: [user1Id], references: [id])
  user2 User @relation("MatchesAsUser2", fields: [user2Id], references: [id])

  @@unique([user1Id, user2Id])
}

model SupportRequest {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  userEmail    String   @map("user_email")
  userFullName String?  @map("user_full_name")
  topic        String
  subject      String
  message      String
  status       String   @default("open")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("support_requests")
}

enum IdentityStatus {
  NOT_VERIFIED
  IN_PROGRESS
  VERIFIED
  REFUSED
}

model Chat {
  id String @id @default(uuid())

  matchId String? @unique
  match   Match?  @relation(fields: [matchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ChatParticipant[]
  messages     Message[]
}

model ChatParticipant {
  id String @id @default(uuid())

  lastReadMessageId String?
  lastReadAt        DateTime?

  hiddenAt       DateTime? @map("hidden_at")
  reminderSentAt DateTime? @map("reminder_sent_at")

  chatId String
  userId String

  lastReadMessage Message? @relation("LastReadMessage", fields: [lastReadMessageId], references: [id], onDelete: SetNull)
  chat            Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id])

  joinedAt DateTime @default(now())

  @@unique([chatId, userId])
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
}

model Message {
  id String @id @default(uuid())

  chatId   String
  senderId String
  content  String

  type          MessageType @default(TEXT)
  attachmentUrl String?     @map("attachment_url")

  attachmentDurationMs Int? @map("attachment_duration_ms")

  editedAt DateTime? @map("edited_at")

  replyToId String?   @map("reply_to_id")
  replyTo   Message?  @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReply")

  chat               Chat                 @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender             User                 @relation(fields: [senderId], references: [id], onDelete: Cascade)
  readByParticipants ChatParticipant[]    @relation("LastReadMessage")
  translations       MessageTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chatId, createdAt])
}

// La traduction est facturee au caractere : on la conserve pour ne jamais
// repayer la traduction d'un message deja vu.
model MessageTranslation {
  id        String @id @default(uuid())
  messageId String
  locale    String
  content   String

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([messageId, locale])
}

model Review {
  id String @id @default(uuid())

  homeId String @map("home_id")
  home   Home   @relation(fields: [homeId], references: [id], onDelete: Cascade)

  authorId String @map("author_id")
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  exchangeId String?   @map("exchange_id")
  exchange   Exchange? @relation(fields: [exchangeId], references: [id], onDelete: SetNull)

  score   Int
  comment String

  reply   String?
  replyAt DateTime? @map("reply_at")

  reports UserReport[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([exchangeId, authorId])
  @@index([homeId])
  @@map("reviews")
}

model PushToken {
  id String @id @default(uuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  token    String  @unique
  platform String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("push_tokens")
}

model BlockedUser {
  id String @id @default(uuid())

  blockerId String @map("blocker_id")
  blockedId String @map("blocked_id")

  blocker User @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@map("blocked_users")
}

model UserReport {
  id String @id @default(uuid())

  reporterId String @map("reporter_id")
  reportedId String @map("reported_id")

  reporter User @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User @relation("ReportsReceived", fields: [reportedId], references: [id], onDelete: Cascade)

  reason  String
  message String?

  reviewId String? @map("review_id")
  review   Review? @relation(fields: [reviewId], references: [id], onDelete: SetNull)

  handledAt DateTime? @map("handled_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([reportedId])
  @@index([handledAt])
  @@map("user_reports")
}

enum NotificationCategory {
  MESSAGES
  EXCHANGES
}

model Notification {
  id     String @id @default(uuid())
  userId String @map("user_id")

  category NotificationCategory @default(MESSAGES)
  title    String
  body     String
  data     Json?

  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

model AppSetting {
  key   String @id
  value Json

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

model CityImage {
  city    String
  country String

  images Json

  fetchedAt DateTime @default(now()) @map("fetched_at")

  @@id([city, country])
  @@map("city_images")
}
