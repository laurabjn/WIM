# Copier vers deploy/.env.prod SUR LE VPS et remplir chaque valeur.
# Ce fichier-ci est un modèle sans secret : il est versionné, .env.prod ne l'est pas.
#
#   cp deploy/.env.prod.example deploy/.env.prod
#   chmod 600 deploy/.env.prod

# --- Domaine & exposition ---------------------------------------------------
# Doit correspondre à l'enregistrement DNS A qui pointe vers l'IP du VPS
# (vps-e3557212.vps.ovh.net = 91.134.134.251).
API_DOMAIN=api.worldismine.fr

# Port de la loopback du VPS sur lequel le conteneur est publié, et vers lequel
# nginx proxifie. 3010 par défaut pour ne pas entrer en conflit avec ce qui
# tourne déjà sur le VPS. Si tu le changes, change aussi `proxy_pass` dans
# deploy/nginx/api.worldismine.fr.conf.
API_HOST_PORT=3010

# --- PostgreSQL -------------------------------------------------------------
# Ces valeurs ne sont lues qu'au TOUT PREMIER démarrage (initdb). Les changer
# après coup ne modifie pas la base existante : il faut soit un ALTER USER,
# soit supprimer le volume wim_pg (donc les données).
POSTGRES_USER=wim
POSTGRES_DB=wim
# Générer : openssl rand -hex 24
# Hexadécimal volontairement : ce mot de passe est injecté dans DATABASE_URL,
# et un caractère comme / + = @ : y serait interprété comme un séparateur
# d'URL, produisant une erreur d'authentification difficile à diagnostiquer.
POSTGRES_PASSWORD=

# --- Secrets JWT ------------------------------------------------------------
# Trois secrets DISTINCTS. Générer chacun : openssl rand -base64 48
# Les changer invalide tous les tokens émis (déconnexion de tous les users).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_RESET_SECRET=
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
JWT_RESET_TTL=3600

# --- CORS & front -----------------------------------------------------------
# Origines autorisées, séparées par des virgules. Sans schéma exact (https://),
# le navigateur bloquera les requêtes.
CORS_ORIGINS=https://worldismine.fr,https://www.worldismine.fr
WS_CORS_ORIGIN=https://worldismine.fr
WS_NAMESPACE=/ws
# Utilisé pour construire les liens de réinitialisation de mot de passe envoyés par mail.
FRONTEND_URL=https://worldismine.fr

# --- Copie des sauvegardes hors du VPS --------------------------------------
# Laisser vide tant que rclone n'est pas configuré : le script de sauvegarde
# fonctionne alors normalement, en local uniquement.
# Format : <nom-du-remote-rclone>:<nom-du-conteneur>
RCLONE_REMOTE=
# Durée de conservation à distance, en jours (14 jours en local).
REMOTE_RETENTION_DAYS=90

# --- SMTP (mails transactionnels) -------------------------------------------
# Le domaine utilise la messagerie OVH (MX Plan / Zimbra) : le serveur d'envoi
# est ssl0.ovh.net. SMTP_USER est l'adresse complète du compte, pas un alias.
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=587
SMTP_USER=noreply@worldismine.fr
SMTP_PASS=

# Adresse qui recoit les alertes de signalement (compte ou avis). C'est un
# destinataire, pas un compte d'envoi : n'importe quelle boite fait l'affaire,
# y compris noreply@worldismine.fr elle-meme ou une adresse hors du domaine.
# Plusieurs adresses se separent par des virgules. Laissee vide, les
# signalements restent consultables dans l'espace admin mais personne n'est
# prevenu par mail.
ADMIN_EMAIL=

# ---------------------------------------------------------------------------
# Traduction automatique des messages (DeepL)
# ---------------------------------------------------------------------------
# Cle depuis https://www.deepl.com/pro-api — l'offre gratuite couvre
# 500 000 caracteres par mois et sa cle se termine par `:fx`, ce qui suffit a
# l'API pour viser le bon domaine.
#
# Laisser vide desactive proprement la traduction : les messages restent
# affiches dans leur langue d'origine et le bandeau ne s'affiche pas.
DEEPL_API_KEY=

# Cle Unsplash (https://unsplash.com/oauth/applications), cote serveur
# uniquement : l'API interroge Unsplash puis met le resultat en cache par
# ville, ce qui tient dans les 50 requetes par heure du palier Demo.
# Laisser vide desactive les photos de ville sans rien casser.
UNSPLASH_ACCESS_KEY=
MAIL_FROM="WIM <noreply@worldismine.fr>"
