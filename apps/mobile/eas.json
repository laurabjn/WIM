{
  "cli": {
    "version": ">= 20.5.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_ENVIRONNEMENT": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.worldismine.fr/api",
        "EXPO_PUBLIC_ENVIRONNEMENT": "preview",
        "EXPO_PUBLIC_APP_URL": "https://app.worldismine.fr"
      }
    },
    "preview-simulator": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.worldismine.fr/api",
        "EXPO_PUBLIC_ENVIRONNEMENT": "preview",
        "EXPO_PUBLIC_APP_URL": "https://app.worldismine.fr"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.worldismine.fr/api",
        "EXPO_PUBLIC_ENVIRONNEMENT": "production",
        "EXPO_PUBLIC_APP_URL": "https://app.worldismine.fr"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
